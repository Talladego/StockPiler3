                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="StockPiler3TabWatch.OnToggleEnabled" />
                        <EventHandler event="OnMouseOver" function="StockPiler3TabWatch.OnMouseOverEnabled" />
                    </EventHandlers>
                </Button>
                <Label name="$parentEnableLabel" font="font_chat_text" maxchars="32" textalign="leftcenter" handleinput="false">
                    <Size>
                        <AbsPoint x="156" y="28" />
                    </Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft">
                            <AbsPoint x="24" y="90" />
                        </Anchor>
                    </Anchors>
                </Label>

                <Button name="$parentAdditives" inherits="EA_Button_DefaultCheckBox">
                    <Size>
                        <AbsPoint x="20" y="20" />
                    </Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft">
                            <AbsPoint x="184" y="94" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="StockPiler3TabWatch.OnToggleAdditives" />

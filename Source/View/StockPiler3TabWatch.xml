                <ListBox name="$parentList" scrollbar="EA_ScrollBar_DefaultVerticalChain" rowdef="StockPiler3WatchRow" visiblerows="11" rowspacing="2">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft">
                            <AbsPoint x="0" y="180" />
                        </Anchor>
                        <Anchor point="bottomright" relativePoint="bottomright">
                            <AbsPoint x="-6" y="-8" />
                        </Anchor>
                    </Anchors>
                    <ListData table="StockPiler3TabWatch.listData" populationfunction="StockPiler3TabWatch.UpdateRows">
                        <ListColumns>
                            <ListColumn windowname="Name" variable="name" format="wstring" />
                            <ListColumn windowname="Status" variable="statusText" format="wstring" />
                            <ListColumn windowname="Stock" variable="stockText" format="wstring" />
                            <ListColumn windowname="Craftable" variable="craftableText" format="wstring" />
                            <ListColumn windowname="Target" variable="targetText" format="wstring" />
                        </ListColumns>
                    </ListData>

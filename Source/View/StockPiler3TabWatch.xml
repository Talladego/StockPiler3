                    <AbsPoint x="0" y="0" />
                </Anchor>
            </Anchors>
            <EventHandlers>
                <EventHandler event="OnInitialize" function="StockPiler3TabWatch.Initialize" />
            </EventHandlers>
            <Windows>
                <Window name="$parentBanner">
                    <Size>
                        <AbsPoint x="500" y="88" />
                    </Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft">
                            <AbsPoint x="0" y="0" />
                        </Anchor>
                        <Anchor point="topright" relativePoint="topright">
                            <AbsPoint x="-20" y="0" />
                        </Anchor>
                    </Anchors>
                    <Windows>
                        <FullResizeImage name="$parentBackground" inherits="SettingsSectionBackground" />
                        <Label name="$parentTitle" inherits="EA_Settings_SectionTitle">
                            <Size>
                                <AbsPoint x="400" y="22" />
                            </Size>
                            <Anchors>
                                <Anchor point="topleft" relativePoint="topleft">
                                    <AbsPoint x="12" y="4" />
                                </Anchor>
                            </Anchors>
                        </Label>
                        <Label name="$parentText" font="font_chat_text" maxchars="320" textalign="left" handleinput="false" wordwrap="true">
                            <Size>
                                <AbsPoint x="960" y="56" />
                            </Size>
                            <Anchors>
                                <Anchor point="topleft" relativePoint="topleft">
                                    <AbsPoint x="12" y="26" />
                                </Anchor>
                            </Anchors>
                        </Label>
                    </Windows>
                </Window>


<?xml version="1.0" encoding="UTF-8"?>
<!-- Tab strip: own handlers (do not use EA_Templates_SettingsWindowTabButton - it calls SettingsWindowTabbed.*). -->
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Windows>
        <Button name="StockPiler3_Templates_TabButton" inherits="EA_Button_Tab">
            <Size>
                <AbsPoint x="124" y="35" />
            </Size>
            <EventHandlers>
                <EventHandler event="OnLButtonUp" function="StockPiler3Window.OnLButtonUpTab" />
            </EventHandlers>
            <TextOffset x="0" y="0" />
        </Button>

        <Button name="StockPiler3_SortHeader" inherits="EA_Button_DefaultListSort" font="font_default_text" textalign="left">
            <Size>
                <AbsPoint x="80" y="28" />
            </Size>
            <TextOffset x="4" y="4" />
            <EventHandlers>
                <EventHandler event="OnLButtonUp" function="StockPiler3TabPotions.OnSortColumn" />
            </EventHandlers>
            <Windows>
                <DynamicImage name="$parentUpArrow" inherits="EA_ListSortUpArrow">
                    <Anchors>
                        <Anchor point="right" relativePoint="right">
                            <AbsPoint x="-12" y="0" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>
                <DynamicImage name="$parentDownArrow" inherits="EA_ListSortDownArrow">
                    <Anchors>
                        <Anchor point="center" relativePoint="center" relativeTo="$parentUpArrow">
                            <AbsPoint x="0" y="0" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>
            </Windows>
        </Button>

        <Button name="StockPiler3_SortHeaderPlants" inherits="EA_Button_DefaultListSort" font="font_default_text" textalign="left">
            <Size>
                <AbsPoint x="80" y="28" />
            </Size>
            <TextOffset x="4" y="4" />
            <EventHandlers>
                <EventHandler event="OnLButtonUp" function="StockPiler3TabPlants.OnSortColumn" />
            </EventHandlers>
            <Windows>
                <DynamicImage name="$parentUpArrow" inherits="EA_ListSortUpArrow">
                    <Anchors>
                        <Anchor point="right" relativePoint="right">
                            <AbsPoint x="-12" y="0" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>
                <DynamicImage name="$parentDownArrow" inherits="EA_ListSortDownArrow">
                    <Anchors>
                        <Anchor point="center" relativePoint="center" relativeTo="$parentUpArrow">
                            <AbsPoint x="0" y="0" />
                        </Anchor>
                    </Anchors>
                </DynamicImage>
            </Windows>
        </Button>

        <!-- Same column-header chrome as StockPiler3_SortHeader, but not clickable and no sort arrows. -->
        <Button name="StockPiler3_StaticHeader" inherits="EA_Button_ListSort" font="font_default_text" textalign="left" handleinput="false">
            <Size>
                <AbsPoint x="80" y="28" />
            </Size>
            <TextOffset x="4" y="4" />
        </Button>

        <!-- Compact row action: gold text, orange hover. -->
        <Button name="StockPiler3_RowTextButton" inherits="EA_Button_DefaultText" font="font_chat_text" textalign="center">
            <Size>
                <AbsPoint x="70" y="28" />
            </Size>
            <TextColors>
                <Normal r="255" g="204" b="102" a="255" />
                <NormalHighlit r="255" g="85" b="0" a="255" />
                <Pressed r="255" g="85" b="0" a="255" />
                <PressedHighlit r="255" g="85" b="0" a="255" />
                <Disabled r="92" g="92" b="92" a="255" />
            </TextColors>
        </Button>

        <!-- Forget: shared Minus-Button artwork (EA_Shared01 / shared_01). -->
        <Button name="StockPiler3_RowForgetButton" inherits="EA_Button_DefaultMinus">
            <Size>
                <AbsPoint x="18" y="18" />
            </Size>
        </Button>

